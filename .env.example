# Copy to .env.local for Vite. Get values from Supabase → Project Settings → API.
#
# VITE_SUPABASE_ANON_KEY must be the "anon" / "public" key — NOT "service_role".
# Using the secret key in the browser triggers: "Forbidden use of secret API key".

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon_key_only

# Optional — local dev only: open System studio without magic-link sign-in when URL/key above are set.
# Do not set this on production builds.
# VITE_BYPASS_STUDIO_AUTH=true
